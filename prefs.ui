<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.4"/>

  <!-- Settings-style sidebar. Preference pages are attached to prefs-stack in prefs.js. -->
  <object class="AdwNavigationSplitView" id="prefs-root">
    <property name="vexpand">True</property>
    <property name="hexpand">True</property>
    <property name="min-sidebar-width">220</property>
    <property name="max-sidebar-width">320</property>
    <property name="sidebar-width-fraction">0.28</property>
    <property name="sidebar">
      <object class="AdwNavigationPage" id="prefs-sidebar-page">
        <property name="title" translatable="yes">Vitals</property>
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-end-title-buttons">False</property>
              </object>
            </child>
            <property name="content">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkListBox" id="prefs-sidebar">
                    <property name="selection-mode">browse</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <style>
                      <class name="navigation-sidebar"/>
                    </style>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">general</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-general">
                                <property name="icon-name">preferences-system-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">General</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="selectable">False</property>
                        <property name="activatable">False</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Sensors</property>
                            <property name="xalign">0</property>
                            <property name="hexpand">True</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">6</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">temperature</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-temperature">
                                <property name="icon-name">temperature-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Temperature</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">coolant</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-coolant">
                                <property name="icon-name">water-droplet-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Coolant</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">voltage</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-voltage">
                                <property name="icon-name">voltage-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Voltage</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">fan</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-fan">
                                <property name="icon-name">fan-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Fan</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">pump</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-pump">
                                <property name="icon-name">pump-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Pump</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">memory</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-memory">
                                <property name="icon-name">memory-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Memory</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">processor</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-processor">
                                <property name="icon-name">cpu-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Processor</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">system</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-system">
                                <property name="icon-name">system-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">System</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">network</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-network">
                                <property name="icon-name">network-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Network</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">storage</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-storage">
                                <property name="icon-name">storage-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Storage</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">battery</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-battery">
                                <property name="icon-name">battery-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Battery</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="name">gpu</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object class="GtkImage" id="sidebar-icon-gpu">
                                <property name="icon-name">gpu-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">GPU</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
    <property name="content">
      <object class="AdwNavigationPage" id="prefs-content-page">
        <property name="title" translatable="yes">General</property>
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-start-title-buttons">False</property>
              </object>
            </child>
            <property name="content">
              <object class="AdwViewStack" id="prefs-stack">
                <property name="vexpand">True</property>
                <property name="hexpand">True</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>

  <object class="GtkAdjustment" id="update-time-adjustment">
    <property name="lower">1</property>
    <property name="upper">60</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="network-public-ip-interval-adjustment">
    <property name="lower">15</property>
    <property name="upper">1440</property>
    <property name="step-increment">1</property>
    <property name="page-increment">15</property>
  </object>

  <!-- General -->
  <object class="AdwPreferencesPage" id="general-page">
    <property name="name">general</property>
    <property name="title" translatable="yes">General</property>
    <property name="icon-name">preferences-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Behavior</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Seconds between updates</property>
            <property name="activatable">False</property>
            <child type="suffix">
              <object class="GtkScale" id="update-time">
                <property name="orientation">horizontal</property>
                <property name="valign">center</property>
                <property name="hexpand">True</property>
                <property name="width-request">200</property>
                <property name="draw-value">True</property>
                <property name="digits">0</property>
                <property name="round-digits">0</property>
                <property name="value-pos">right</property>
                <property name="adjustment">update-time-adjustment</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Position in panel</property>
            <property name="activatable-widget">position-in-panel</property>
            <child type="suffix">
              <object class="GtkComboBoxText" id="position-in-panel">
                <property name="valign">center</property>
                <items>
                  <item translatable="yes">Left</item>
                  <item translatable="yes">Center</item>
                  <item translatable="yes">Right</item>
                  <item translatable="yes">Far Left</item>
                  <item translatable="yes">Far Right</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Menu always centered</property>
            <property name="activatable-widget">menu-centered</property>
            <child type="suffix">
              <object class="GtkSwitch" id="menu-centered">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Appearance</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Use higher precision</property>
            <property name="activatable-widget">use-higher-precision</property>
            <child type="suffix">
              <object class="GtkSwitch" id="use-higher-precision">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Alphabetize sensors</property>
            <property name="activatable-widget">alphabetize</property>
            <child type="suffix">
              <object class="GtkSwitch" id="alphabetize">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Hide zero values</property>
            <property name="activatable-widget">hide-zeros</property>
            <child type="suffix">
              <object class="GtkSwitch" id="hide-zeros">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Use fixed widths</property>
            <property name="activatable-widget">fixed-widths</property>
            <child type="suffix">
              <object class="GtkSwitch" id="fixed-widths">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Hide icons in top bar</property>
            <property name="activatable-widget">hide-icons</property>
            <child type="suffix">
              <object class="GtkSwitch" id="hide-icons">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Icon style</property>
            <property name="activatable-widget">icon-style</property>
            <child type="suffix">
              <object class="GtkComboBoxText" id="icon-style">
                <property name="valign">center</property>
                <items>
                  <item translatable="yes">Original</item>
                  <item translatable="yes">GNOME</item>
                </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">About</property>
        <property name="description" translatable="yes">Feature requests or bugs? Please visit &lt;a href=&quot;https://github.com/corecoding/Vitals/issues&quot;&gt;GitHub&lt;/a&gt;. No warranty, expressed or implied. &lt;a href=&quot;https://corecoding.com/donate.php&quot;&gt;Donate&lt;/a&gt; if you found this useful.</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
      </object>
    </child>
  </object>

  <!-- Temperature -->
  <object class="AdwPreferencesPage" id="temperature-page">
    <property name="name">temperature</property>
    <property name="title" translatable="yes">Temperature</property>
    <property name="icon-name">temperature-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Monitor temperature</property>
            <property name="activatable-widget">show-temperature</property>
            <child type="suffix">
              <object class="GtkSwitch" id="show-temperature">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Unit</property>
            <property name="activatable-widget">unit</property>
            <child type="suffix">
              <object class="GtkComboBoxText" id="unit">
                <property name="valign">center</property>
                <items>
                  <item translatable="yes">°C</item>
                  <item translatable="yes">°F</item>
                </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <!-- Coolant -->
  <object class="AdwPreferencesPage" id="coolant-page">
    <property name="name">coolant</property>
    <property name="title" translatable="yes">Coolant</property>
    <property name="icon-name">water-droplet-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Monitor coolant</property>
            <property name="activatable-widget">show-coolant</property>
            <child type="suffix">
              <object class="GtkSwitch" id="show-coolant">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Unit</property>
            <property name="activatable-widget">coolant-unit</property>
            <child type="suffix">
              <object class="GtkComboBoxText" id="coolant-unit">
                <property name="valign">center</property>
                <items>
                  <item translatable="yes">°C</item>
                  <item translatable="yes">°F</item>
                </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <!-- Voltage -->
  <object class="AdwPreferencesPage" id="voltage-page">
    <property name="name">voltage</property>
    <property name="title" translatable="yes">Voltage</property>
    <property name="icon-name">voltage-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Monitor voltage</property>
